# Public client configuration only. Never add an OpenAI, Stripe, Supabase service-role
# or Meta secret to this file or to the Tauri application.
VITE_SCENARIO_API_BASE_URL=https://api.example.invalid
VITE_SCENARIO_ENVIRONMENT=staging
VITE_SCENARIO_AUTH_MODE=supabase
VITE_SCENARIO_CLIENT_VERSION=0.1.7
VITE_SCENARIO_CLIENT_MIN_SUPPORTED_VERSION=0.0.0
VITE_SUPABASE_URL=https://project-ref.supabase.co
# Supabase anon/publishable key only. Never use service_role in a VITE variable.
VITE_SUPABASE_ANON_KEY=public-anon-key-placeholder
