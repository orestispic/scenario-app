{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "senario",
  "version": "0.1.8",
  "identifier": "fr.orepi.scenario",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "senario",
        "theme": "Dark",
        "backgroundColor": "#080b10",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "icons/scenario-file-icon.ico": "scenario-file-icon.ico"
    },
    "fileAssociations": [
      {
        "ext": ["scenario"],
        "name": "Projet senario",
        "description": "Projet senario",
        "role": "Editor",
        "mimeType": "application/x-scenario-project"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MzVBQjVCRUY5RDk2NzIKUldSeWxwM3ZXNnMxaDFsRmk1RHpHcDl6ZS8ybllIR3U1eXE2YXF4K2FZWnViOXB3UThGMk16UkYK",
      "endpoints": [
        "https://github.com/orestispic/scenario-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
