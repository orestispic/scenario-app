{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "senario",
  "version": "0.1.18",
  "identifier": "fr.orepi.scenario",
  "build": {
    "beforeDevCommand": "npm run audio:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run audio:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "senario",
        "theme": "Dark",
        "backgroundColor": "#080b10",
        "width": 800,
        "height": 600,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://scenario-commercial-api-production.ore-picard.workers.dev wss://scenario-commercial-api-production.ore-picard.workers.dev https://rtqlsnwfbtnscilfdirv.supabase.co wss://rtqlsnwfbtnscilfdirv.supabase.co; img-src 'self' asset: http://asset.localhost http://senario-image.localhost data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "icons/scenario-file-icon.ico": "scenario-file-icon.ico",
      "audio-runtime/": "audio-runtime/",
      "../licenses/audio/": "licenses/audio/",
      "../THIRD_PARTY_NOTICES_AUDIO.txt": "THIRD_PARTY_NOTICES_AUDIO.txt",
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES"
    },
    "fileAssociations": [
      {
        "ext": ["scenario"],
        "name": "Projet senario",
        "description": "Projet senario",
        "role": "Editor",
        "mimeType": "application/x-scenario-project"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MzVBQjVCRUY5RDk2NzIKUldSeWxwM3ZXNnMxaDFsRmk1RHpHcDl6ZS8ybllIR3U1eXE2YXF4K2FZWnViOXB3UThGMk16UkYK",
      "endpoints": [
        "https://github.com/orestispic/scenario-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
